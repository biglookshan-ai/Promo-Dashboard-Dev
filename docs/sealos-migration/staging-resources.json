{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "labels": {
          "app": "promotion-sealos",
          "cloud.sealos.io/app-deploy-manager": "promotion-sealos"
        },
        "name": "promotion-sealos",
        "namespace": "ns-hyizeqfa"
      },
      "spec": {
        "progressDeadlineSeconds": 600,
        "replicas": 1,
        "revisionHistoryLimit": 10,
        "selector": {
          "matchLabels": {
            "app": "promotion-sealos"
          }
        },
        "strategy": {
          "type": "Recreate"
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "promotion-sealos",
              "cloud.sealos.io/app-deploy-manager": "promotion-sealos"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "env": [
                  {
                    "name": "MIGRATION_MODE",
                    "value": "staging"
                  },
                  {
                    "name": "SCHEDULER_DISABLED",
                    "value": "1"
                  },
                  {
                    "name": "EXECUTOR_DISABLED",
                    "value": "1"
                  },
                  {
                    "name": "REQUIRE_RESTORED_DATA",
                    "value": "1"
                  },
                  {
                    "name": "DATA_DIR",
                    "value": "/data"
                  },
                  {
                    "name": "PORT",
                    "value": "3000"
                  }
                ],
                "image": "ghcr.io/biglookshan-ai/promotion-sealos@sha256:8b33ba6db7d6cb10b50290adfb11e8167ce787e3b414f90d831b233377727b56",
                "imagePullPolicy": "IfNotPresent",
                "livenessProbe": {
                  "failureThreshold": 3,
                  "httpGet": {
                    "path": "/healthz",
                    "port": 3000,
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 20,
                  "periodSeconds": 20,
                  "successThreshold": 1,
                  "timeoutSeconds": 1
                },
                "name": "app",
                "ports": [
                  {
                    "containerPort": 3000,
                    "protocol": "TCP"
                  }
                ],
                "readinessProbe": {
                  "failureThreshold": 3,
                  "httpGet": {
                    "path": "/healthz",
                    "port": 3000,
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 3,
                  "periodSeconds": 5,
                  "successThreshold": 1,
                  "timeoutSeconds": 1
                },
                "resources": {
                  "limits": {
                    "cpu": "500m",
                    "ephemeral-storage": "1Gi",
                    "memory": "512Mi"
                  },
                  "requests": {
                    "cpu": "50m",
                    "memory": "128Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "terminationMessagePath": "/dev/termination-log",
                "terminationMessagePolicy": "File",
                "volumeMounts": [
                  {
                    "mountPath": "/data",
                    "name": "data",
                    "readOnly": true
                  }
                ]
              },
              {
                "command": [
                  "node",
                  "scripts/backup-loop.mjs"
                ],
                "env": [
                  {
                    "name": "DATA_DIR",
                    "value": "/data"
                  },
                  {
                    "name": "BACKUP_DIR",
                    "value": "/backups"
                  },
                  {
                    "name": "BACKUP_INTERVAL_SECONDS",
                    "value": "600"
                  }
                ],
                "envFrom": [
                  {
                    "secretRef": {
                      "name": "promotion-backup-env"
                    }
                  }
                ],
                "image": "ghcr.io/biglookshan-ai/promotion-sealos@sha256:8b33ba6db7d6cb10b50290adfb11e8167ce787e3b414f90d831b233377727b56",
                "imagePullPolicy": "IfNotPresent",
                "name": "backup",
                "resources": {
                  "limits": {
                    "cpu": "200m",
                    "ephemeral-storage": "1Gi",
                    "memory": "256Mi"
                  },
                  "requests": {
                    "cpu": "50m",
                    "memory": "128Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "terminationMessagePath": "/dev/termination-log",
                "terminationMessagePolicy": "File",
                "volumeMounts": [
                  {
                    "mountPath": "/data",
                    "name": "data",
                    "readOnly": true
                  },
                  {
                    "mountPath": "/backups",
                    "name": "backups"
                  }
                ]
              }
            ],
            "dnsPolicy": "ClusterFirst",
            "imagePullSecrets": [
              {
                "name": "promotion-ghcr-pull"
              }
            ],
            "restartPolicy": "Always",
            "schedulerName": "default-scheduler",
            "securityContext": {
              "fsGroup": 1000,
              "runAsGroup": 1000,
              "runAsNonRoot": true,
              "runAsUser": 1000,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "terminationGracePeriodSeconds": 30,
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "promotion-sealos-data"
                }
              },
              {
                "name": "backups",
                "persistentVolumeClaim": {
                  "claimName": "promotion-sealos-backups"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "labels": {
          "app": "promotion-sealos",
          "cloud.sealos.io/app-deploy-manager": "promotion-sealos"
        },
        "name": "promotion-sealos",
        "namespace": "ns-hyizeqfa"
      },
      "spec": {
        "internalTrafficPolicy": "Cluster",
        "ports": [
          {
            "port": 3000,
            "protocol": "TCP",
            "targetPort": 3000
          }
        ],
        "selector": {
          "app": "promotion-sealos"
        },
        "sessionAffinity": "None",
        "type": "ClusterIP"
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": {
        "labels": {
          "app": "promotion-sealos",
          "cloud.sealos.io/app-deploy-manager": "promotion-sealos",
          "cloud.sealos.io/app-deploy-manager-domain": "promotion-cgp-hyizeqfa"
        },
        "name": "promotion-sealos",
        "namespace": "ns-hyizeqfa",
        "annotations": {
          "kubernetes.io/ingress.class": "nginx",
          "nginx.ingress.kubernetes.io/backend-protocol": "HTTP",
          "nginx.ingress.kubernetes.io/ssl-redirect": "true"
        }
      },
      "spec": {
        "rules": [
          {
            "host": "promotion-cgp-hyizeqfa.cloud.sealos.io",
            "http": {
              "paths": [
                {
                  "backend": {
                    "service": {
                      "name": "promotion-sealos",
                      "port": {
                        "number": 3000
                      }
                    }
                  },
                  "path": "/",
                  "pathType": "Prefix"
                }
              ]
            }
          }
        ],
        "tls": [
          {
            "hosts": [
              "promotion-cgp-hyizeqfa.cloud.sealos.io"
            ],
            "secretName": "wildcard-cloud-sealos-io-cert"
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "labels": {
          "app": "promotion-sealos",
          "cloud.sealos.io/app-deploy-manager": "promotion-sealos"
        },
        "name": "promotion-sealos-data",
        "namespace": "ns-hyizeqfa",
        "annotations": {
          "volume.beta.kubernetes.io/storage-provisioner": "local.csi.openebs.io"
        }
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "1Gi"
          }
        },
        "storageClassName": "openebs-lvmpv-node",
        "volumeMode": "Filesystem"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "labels": {
          "app": "promotion-sealos",
          "cloud.sealos.io/app-deploy-manager": "promotion-sealos"
        },
        "name": "promotion-sealos-backups",
        "namespace": "ns-hyizeqfa",
        "annotations": {
          "volume.beta.kubernetes.io/storage-provisioner": "local.csi.openebs.io"
        }
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "2Gi"
          }
        },
        "storageClassName": "openebs-lvmpv-node",
        "volumeMode": "Filesystem"
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "labels": {
          "app": "promotion-sealos",
          "cloud.sealos.io/app-deploy-manager": "promotion-sealos"
        },
        "name": "promotion-sealos-isolation",
        "namespace": "ns-hyizeqfa"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app": "promotion-sealos"
          }
        },
        "policyTypes": [
          "Egress"
        ]
      }
    },
    {
      "apiVersion": "cilium.io/v2",
      "kind": "CiliumNetworkPolicy",
      "metadata": {
        "name": "promotion-backup-only",
        "namespace": "ns-hyizeqfa"
      },
      "spec": {
        "egress": [
          {
            "toEndpoints": [
              {
                "matchLabels": {
                  "k8s:io.kubernetes.pod.namespace": "kube-system",
                  "k8s:k8s-app": "kube-dns"
                }
              }
            ],
            "toPorts": [
              {
                "ports": [
                  {
                    "port": "53",
                    "protocol": "ANY"
                  }
                ],
                "rules": {
                  "dns": [
                    {
                      "matchPattern": "*"
                    }
                  ]
                }
              }
            ]
          },
          {
            "toFQDNs": [
              {
                "matchName": "objectstorageapi.cloud.sealos.io"
              }
            ],
            "toPorts": [
              {
                "ports": [
                  {
                    "port": "443",
                    "protocol": "TCP"
                  }
                ]
              }
            ]
          }
        ],
        "endpointSelector": {
          "matchLabels": {
            "app": "promotion-sealos"
          }
        }
      }
    },
    {
      "apiVersion": "objectstorage.sealos.io/v1",
      "kind": "ObjectStorageBucket",
      "metadata": {
        "labels": {
          "app": "promotion-sealos",
          "cloud.sealos.io/app-deploy-manager": "promotion-sealos"
        },
        "name": "promotion-backups",
        "namespace": "ns-hyizeqfa"
      },
      "spec": {
        "policy": "private"
      }
    }
  ]
}
